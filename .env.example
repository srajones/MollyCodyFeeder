# ============================================================================
# POOR PUPPY — Molly & Cody Smart Feeder watchdog configuration
# Copy to .env and fill in:  cp .env.example .env   (never commit .env)
# Every key below is read by the code; blank = feature disabled / default used.
# ============================================================================

# --- Account & device ---------------------------------------------------------
# Molly & Cody app login (MOLLY_USER/MOLLY_PASS preferred; legacy USER/PASS still work)
MOLLY_USER=
MOLLY_PASS=
COUNTRY_CODE=1
# Device id of the feeder (see `./kibble status` / tuya_session.json)
TUYA_DEVICE_ID=
# Only needed for the optional Tuya device-sharing QR login script
USER_CODE=

# Timezone of the FEEDER's schedule (meal times are local). REQUIRED on a VPS/Docker,
# which otherwise runs on UTC and checks meals hours late/early.
TZ=America/New_York

# --- Connection mode: auto | cloud | lan --------------------------------------
FEEDER_MODE=cloud
# LAN control (optional; only used in auto/lan mode)
FEEDER_LOCAL_IP=
FEEDER_LOCAL_KEY=
FEEDER_PROTOCOL_VERSION=3.4

# --- Verification -------------------------------------------------------------
# Fallback meal times if the feeder schedule (DP 207) can't be read
FEED_SCHEDULE_TIMES=07:00,11:00,16:00,19:00
# Base recording window (seconds). Recording auto-extends while the motor still runs.
RECORD_DURATION_SECONDS=12
RECORD_MAX_EXTEND_SECONDS=60
# Scheduled meals: start watching this many seconds BEFORE the meal time
MEAL_PREROLL_SECONDS=40
# Audio: kibble-impact spikes required during the motor window (min 15 enforced)
MIN_KIBBLE_AUDIO_PEAKS=15
# Kibble 'ting' rate (pellet-on-steel impacts per motor second) that means food came out
TING_RATE_MIN=4.3
# Feeds in a row without the ting before an URGENT clog/no-food alert (1 miss = heads-up)
NO_TING_ESCALATE_AFTER=2
# Visual (daylight): minimum inner-bowl fill ratio
MIN_BOWL_FILL_RATIO=0.04
BOWL_ROI=0.10,0.885,0.93,0.995
# Optional external stream instead of the built-in cloud camera session
CAMERA_STREAM_URL=

# --- Alert policy ---------------------------------------------------------------
# every_miss    = per-feed kibble 'ting' rules (1 miss = heads-up, NO_TING_ESCALATE_AFTER in a row = urgent)
# no_food_hours = ONLY alert if no food evidence (feed with the ting / food seen in a bowl snapshot) for X hours
ALERT_MODE=every_miss
NO_FOOD_ALERT_HOURS=8
FOOD_CHECK_INTERVAL_MIN=60

# --- Anti-clog retries & overfeed guard ---------------------------------------
AUTO_RETRY_ON_CLOG=true
MAX_RETRY_ATTEMPTS=1
# Max extra portions the watchdog may auto-dispense per day
MAX_DAILY_RETRY_PORTIONS=3

# --- Hopper estimate (run `./kibble refill` after filling) ----------------------
HOPPER_CAPACITY_PORTIONS=240
HOPPER_LOW_PERCENT=20

# --- Proactive checks -----------------------------------------------------------
# Warn this many seconds before each meal if the feeder is offline (0 = off)
PRE_MEAL_ONLINE_CHECK_SECONDS=300
# Health: re-check the bowl this many minutes after a verified meal (daylight only, 0 = off)
EATEN_CHECK_MINUTES=120
# Daily summary push time (HH:MM, blank = off)
DAILY_SUMMARY_TIME=21:00
# Dead-man switch pinged every 5 min (e.g. https://hc-ping.com/<uuid>)
HEARTBEAT_URL=
# Same alert type is not re-sent within this many minutes
ALERT_COOLDOWN_MINUTES=20

# --- Footage / capture retention & ML export ---------------------------------
# false = delete media after analysis; metrics still saved to DB
KEEP_FOOTAGE=true
# delete media older than N days; 0 = keep forever (if KEEP_FOOTAGE=true)
CAPTURE_RETENTION_DAYS=30
# optional longer keep for clog/fail events (fallback to CAPTURE_RETENTION_DAYS if unset)
KEEP_FAILED_FOOTAGE_DAYS=90
# already used; keep consistent with compose volume ./captures
CAPTURES_DIR=/tmp/poor_puppy_captures
# Optional: drop only the MP4 of verified-good feeds after N days while keeping snapshots/WAV (0 = off)
VIDEO_KEEP_DAYS_OK=0
# Disk safety cap for CAPTURES_DIR (0 = off); oldest media is purged first if exceeded
CAPTURE_MAX_MB=2048

# Always persist structured metrics in SQLite (never auto-delete DB rows by default)
# 0 = keep feed_events forever; if >0, prune old rows but prefer KEEP metrics
DB_RETENTION_DAYS=0
# before deleting media/rows, append a JSONL export of the event metrics
EXPORT_ML_ON_PRUNE=true
ML_EXPORT_PATH=data/ml_events.jsonl
# Local SQLite path (docker-compose overrides to /app/data/kibble_history.db)
DB_PATH=kibble_history.db

TTS_CACHE_DIR=
# Review Lab (review_server.py): optional token; open the page once as /?t=<token>
REVIEW_TOKEN=

# --- HTTP API (Home Assistant / automations) ----------------------------------
# Container-internal only by default (docker-compose publishes ZERO host ports).
# Keep 127.0.0.1 unless you need LAN access; if exposed, ALWAYS set WEBHOOK_SECRET.
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8080
# Send as "Authorization: Bearer <secret>" or "X-Webhook-Token: <secret>"
WEBHOOK_SECRET=
# Outbound Home Assistant webhook (e.g. https://ha.example.com/api/webhook/poor_puppy_<secret_id>)
# Works 100% outbound from the VPS with zero inbound ports opened.
HA_WEBHOOK_URL=
HA_NOTIFY_ON_SUCCESS=true
PUBLIC_BASE_URL=

# --- Alerts -------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC_URL=

# --- Feeder speaker voice alerts & custom TTS (`pp-settings say` / `tts`) -----
# Uses built-in Cloud two-way speaker (8 kHz G.711 mulaw via edge-tts / espeak-ng fallback in container),
# or falls back to HA_WEBHOOK_URL (event="tts_speak") if configured.
TTS_ALERT_ON_CLOG=true
TTS_ALERT_MESSAGE=Attention! The dog feeder is clogged and no food was dispensed. Please check the feeder bowl.
TTS_VOICE=en-US-AriaNeural
# Gain before the soft limiter (values > 1 are safe: the limiter prevents clipping)
TTS_VOLUME=2.5
# Repetitions for automated clog voice alerts (interactive `kibble say` / `pp-settings say` speaks once by default)
TTS_REPEAT=2

# --- Optional vision LLM double-check -----------------------------------------
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash

# --- Safe updates (update-pp / pp-settings -> 8 -> m) ------------------------------
# update-pp refuses to restart the container from N minutes before until N minutes after a scheduled
# meal (or while a verification is running), because a restart kills that meal's recording. --force overrides.
UPDATE_GUARD_BEFORE_MIN=10
UPDATE_GUARD_AFTER_MIN=5

WEAK_FLOW_TING_RATE=4.6
