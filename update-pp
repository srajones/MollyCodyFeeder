#!/usr/bin/env bash
# ============================================================================
# update-pp — Safe day-2 updater for Poor Puppy on an Ubuntu VPS
#
# Usage:
#   update-pp                  fetch + stay on current branch + ff-only pull + safe rebuild
#   update-pp --latest         fetch + auto-pick newest vN / vN.M branch + ff-only pull + safe rebuild
#   update-pp --branch v0.6    fetch + switch to v0.6 + ff-only pull + safe rebuild
#   update-pp --no-pull        safe rebuild & restart only (no git operations)
#   update-pp --status         what's installed, is an update available, container health, next meal, history
#   update-pp --selftest       run the connection self-test against the running watchdog (no feed)
#
# Every update (the "safe rebuild"):
#   1. Refuses to start within UPDATE_GUARD_BEFORE_MIN (10) min before / UPDATE_GUARD_AFTER_MIN (5) min after
#      a scheduled meal, or while a feed verification is running (a restart kills the recording). --force overrides.
#   2. git fetch + ff-only pull, then re-runs itself from the NEWLY pulled update-pp (new logic for the rest).
#   3. Tags the running image as poor-puppy-watchdog:rollback (+ :rollback-<oldcommit>).
#   4. Builds the new image while the old container keeps running (build failure -> git restored, nothing changed).
#   5. Offline smoke test of the new image (imports, .env config, DB migrations + quick_check on a COPY of the DB).
#   6. Backs up data/kibble_history.db to data/backups/pre-update-<time>-<oldcommit>.db (newest 5 kept).
#   7. Switches containers, waits for healthy + "Puppy Feeder Watchdog running", then runs GET /selftest inside
#      the container (existing cloud session only — never a password login — and never dispenses food).
#   8. Any failure -> automatic rollback to the previous image + previous commit on the original branch
#      (--no-rollback to opt out). Every run is appended to data/update-history.log.
#
# Guarantees:
#   - Refuses to run if .env, data/, or captures/ is missing (use ./install_ubuntu.sh first)
#   - Refuses to pull if tracked code files have uncommitted changes (ignores operator data/captures/exports)
#   - Never overwrites or deletes .env values, data/, captures/, tuya_session.json, or exports/
#   - Only appends newly added keys from .env.example that are missing in .env
#   - Scoped strictly to this directory's docker compose project (zero host ports)
# ============================================================================
set -euo pipefail

CONTAINER="poor-puppy-watchdog"
SERVICE="feeder-watchdog"
ROLLBACK_REPO="poor-puppy-watchdog"
RUNNING_MARKER="Puppy Feeder Watchdog running"

usage() {
    cat <<'EOF'
Usage: update-pp [options]

Default:
  update-pp                  Stay on current branch, git pull --ff-only, safe rebuild (build, test, switch, verify)

Options:
  --latest             Auto-select highest version branch (vN / vN.M) across local+origin
  --branch NAME        Switch to / stay on branch NAME before pulling
  --no-pull            Skip git fetch/checkout/pull; safe rebuild and restart only
  --force              Skip the meal-window / busy guard (a restart during a meal loses that meal's verification)
  --no-rollback        On a failed check, leave the new version running and print manual rollback steps
  --no-camera-check    Skip the camera snapshot in the post-update self-test
  --status             Show installed version, available updates, container health, next meal, update history
  --selftest           Run the connection self-test against the running container (no feed, no login)
  --rollback-on-fail   (Accepted for compatibility; automatic rollback is now the default)
  -h, --help           Show this help message

Settings (.env): UPDATE_GUARD_BEFORE_MIN=10  UPDATE_GUARD_AFTER_MIN=5
EOF
}

say()  { printf '\n\033[1;36m🐶 %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m⚠️  %s\033[0m\n' "$*"; }
err()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }

# --------------------------------------------------------------------------- python helper (stdlib only)
write_py_helper() {
    PYHELP="$(mktemp "${TMPDIR:-/tmp}/pp-update-helper.XXXXXX")"
    cat > "$PYHELP" <<'PY'
import ast, json, os, re, sqlite3, subprocess, sys, time
from datetime import datetime
from pathlib import Path


def read_env(path):
    vals = {}
    p = Path(path)
    if p.is_file():
        for line in p.read_text(encoding="utf-8", errors="ignore").splitlines():
            m = re.match(r"^\s*([A-Z0-9_]+)\s*=(.*)$", line)
            if m:
                vals[m.group(1)] = re.sub(r"\s+#.*$", "", m.group(2)).strip().strip('"').strip("'")
    return vals


def env_backfill(env_path, ex_path):
    env_path, ex_path = Path(env_path), Path(ex_path)
    existing_lines = env_path.read_text(encoding="utf-8", errors="ignore").splitlines()
    existing_keys = set()
    for line in existing_lines:
        m = re.match(r"^\s*([A-Z0-9_]+)\s*=", line)
        if m:
            existing_keys.add(m.group(1))
    added = []
    if ex_path.is_file():
        for line in ex_path.read_text(encoding="utf-8", errors="ignore").splitlines():
            m = re.match(r"^\s*([A-Z0-9_]+)\s*=(.*)$", line)
            if m and m.group(1) not in existing_keys:
                val = re.sub(r"\s+#.*$", "", m.group(2)).strip()
                added.append(f"{m.group(1)}={val}")
                existing_keys.add(m.group(1))
    defaults = {
        "KEEP_FOOTAGE": "true",
        "CAPTURE_RETENTION_DAYS": "30",
        "KEEP_FAILED_FOOTAGE_DAYS": "90",
        "VIDEO_KEEP_DAYS_OK": "0",
        "CAPTURE_MAX_MB": "2048",
        "DB_RETENTION_DAYS": "0",
        "EXPORT_ML_ON_PRUNE": "true",
        "ML_EXPORT_PATH": "data/ml_events.jsonl",
        "WEBHOOK_LISTEN_HOST": "127.0.0.1",
        "HA_NOTIFY_ON_SUCCESS": "true",
    }
    for k, v in defaults.items():
        if k not in existing_keys:
            added.append(f"{k}={v}")
            existing_keys.add(k)
    if added:
        with open(env_path, "a", encoding="utf-8") as fh:
            if existing_lines and existing_lines[-1].strip() != "":
                fh.write("\n")
            fh.write("# --- Added by update-pp (defaults for new settings) ---\n")
            for item in added:
                fh.write(item + "\n")
        print(f"   Added {len(added)} new default key(s) to .env (existing values untouched).")


def latest_branch(remote_only=False):
    out = subprocess.check_output(["git", "branch", "-a", "--format=%(refname:short)"], text=True)
    candidates = set()
    for raw in out.splitlines():
        name = raw.strip()
        is_remote = name.startswith("origin/")
        if remote_only and not is_remote:
            continue
        if is_remote:
            name = name[len("origin/"):]
        if re.fullmatch(r"v\d+(?:\.\d+)*", name):
            candidates.add(name)
    if not candidates:
        print("" if remote_only else subprocess.check_output(["git", "rev-parse", "--abbrev-ref", "HEAD"], text=True).strip())
        return
    print(sorted(candidates, key=lambda b: tuple(int(x) for x in b[1:].split(".")))[-1])


def _mins(sec):
    sec = max(0, int(sec))
    return f"{sec // 3600}h{(sec % 3600) // 60:02d}m" if sec >= 3600 else f"{max(1, round(sec / 60))} min"


def guard(env_file, health_raw, logs_file):
    """Prints 'ok|block|unknown<TAB>wait_seconds<TAB>message'. Meal times come from the running daemon's
    /health (v0.6+) or, for older containers, from its 'Monitoring meals' / 'Synced ... DP 207' log lines."""
    env = read_env(env_file)
    before = int(float(env.get("UPDATE_GUARD_BEFORE_MIN") or 10) * 60)
    after = int(float(env.get("UPDATE_GUARD_AFTER_MIN") or 5) * 60)
    preroll = int(float(env.get("MEAL_PREROLL_SECONDS") or 40))
    before = max(before, preroll + 60)
    try:
        health = json.loads(health_raw) if health_raw.strip() else None
    except Exception:
        health = None
    if isinstance(health, dict) and "busy" in health:
        if health.get("busy"):
            print("block\t60\ta feed verification is running right now")
            return
        if not health.get("meal_count") or health.get("next_meal_in_sec") is None:
            print("ok\t0\tno scheduled meal checks in the running watchdog")
            return
        nxt = int(health["next_meal_in_sec"])
        last = health.get("last_meal_ago_sec")
        last = int(last) if last is not None else None
        source = "watchdog"
    else:
        text = Path(logs_file).read_text(encoding="utf-8", errors="ignore") if logs_file and Path(logs_file).is_file() else ""
        times, fallback_after = None, False
        pat = re.compile(r"(?:Monitoring meals: |Synced enabled feeding times from feeder DP 207: )(\[[^\]]*\])")
        for line in text.splitlines():
            m = pat.search(line)
            if m:
                try:
                    times, fallback_after = [str(t) for t in ast.literal_eval(m.group(1))], False
                except Exception:
                    pass
            elif "Could not sync schedule from feeder, using fallback" in line and times is not None:
                fallback_after = True
        if times is None:
            print("unknown\t0\tcould not determine the meal schedule (older watchdog without schedule lines in its logs)")
            return
        if fallback_after:  # the daemon fell back to FEED_SCHEDULE_TIMES: guard both lists (conservative)
            fb = env.get("FEED_SCHEDULE_TIMES") or "07:00,11:00,16:00,19:00"
            times = sorted(set(times) | {t.strip() for t in fb.split(",") if t.strip()})
        if not times:
            print("ok\t0\tno enabled meals in the watchdog's last schedule sync")
            return
        if env.get("TZ"):
            os.environ["TZ"] = env["TZ"]
        else:
            os.environ["TZ"] = "UTC"  # the container runs in UTC when TZ is not set in .env
        time.tzset()
        now_s = os.environ.get("PP_NOW_EPOCH")
        now = datetime.fromtimestamp(float(now_s)) if now_s else datetime.now()
        nexts, lasts = [], []
        for t in times:
            try:
                hh, mm = (int(x) for x in t.split(":")[:2])
            except ValueError:
                continue
            d = (now.replace(hour=hh, minute=mm, second=0, microsecond=0) - now).total_seconds()
            nexts.append(d % 86400)
            lasts.append((-d) % 86400)
        if not nexts:
            print("unknown\t0\tcould not parse the meal times from the logs")
            return
        nxt, last, source = int(min(nexts)), int(min(lasts)), "logs"
    if nxt <= before:
        print(f"block\t{nxt + after}\tnext meal is in {_mins(nxt)} (updates wait until {after // 60} min after it) [{source}]")
    elif last is not None and last < after:
        print(f"block\t{after - last}\ta meal was {_mins(last)} ago (its verification may still be running) [{source}]")
    else:
        print(f"ok\t0\tnext meal in {_mins(nxt)} [{source}]")


def backup(db_path, backup_dir, old_commit, keep):
    db, bdir = Path(db_path), Path(backup_dir)
    if not db.exists():
        print("SKIP no database yet")
        return 0
    if os.geteuid() == 0:  # write as the data/ owner (container uid 1000) so no root-owned files land in data/
        st = db.parent.stat()
        if st.st_uid != 0:
            os.setgid(st.st_gid)
            os.setuid(st.st_uid)
    bdir.mkdir(parents=True, exist_ok=True)
    out = bdir / f"pre-update-{time.strftime('%Y%m%d-%H%M%S')}-{old_commit}.db"
    src = sqlite3.connect(str(db), timeout=30.0)
    try:
        dst = sqlite3.connect(str(out))
        try:
            src.backup(dst)
            res = dst.execute("PRAGMA quick_check;").fetchone()
        finally:
            dst.close()
    finally:
        src.close()
    if not res or res[0] != "ok":
        out.unlink(missing_ok=True)
        print(f"FAIL backup quick_check returned {res}")
        return 1
    os.chmod(out, 0o600)
    olds = sorted(bdir.glob("pre-update-*.db"))
    for p in olds[: max(0, len(olds) - int(keep))]:
        p.unlink(missing_ok=True)
    print(f"OK {out}")
    return 0


ICONS = {"pass": "✅", "warn": "⚠️ ", "fail": "❌", "skip": "⏭️ "}


def selftest_summary(raw_file):
    """Exit codes: 0 pass, 1 warn, 2 fail, 3 busy (409), 4 not available on this version (404), 5 no answer."""
    raw = Path(raw_file).read_text(encoding="utf-8", errors="ignore")
    m = re.search(r"\nHTTP_CODE:(\d{3})\s*$", "\n" + raw)
    code = int(m.group(1)) if m else 0
    body = raw[: m.start() - 1] if m else raw
    try:
        rep = json.loads(body) if body.strip() else None
    except Exception:
        rep = None
    if code == 404:
        print("   ⚠️  /selftest not available in this version (health check only)")
        return 4
    if code == 409:
        print(f"   ⏳ busy: {(rep or {}).get('error', 'verification running')}")
        return 3
    if not isinstance(rep, dict) or "overall" not in rep:
        tail = " ".join(body.strip().splitlines()[-3:])[:200] or "no response"
        print(f"   ❌ self-test gave no usable answer (HTTP {code or '?'}): {tail}")
        return 5
    for c in rep.get("checks", []):
        print(f"   {ICONS.get(c.get('status'), '•')} {c.get('name')}: {c.get('detail')}")
    print(f"   => overall: {str(rep['overall']).upper()} ({rep.get('duration_sec', '?')}s)")
    return {"pass": 0, "warn": 1}.get(rep["overall"], 2)


if __name__ == "__main__":
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "env-backfill":
        env_backfill(*args)
    elif cmd == "latest-branch":
        latest_branch(remote_only=bool(args and args[0] == "remote"))
    elif cmd == "guard":
        guard(args[0], os.environ.get("PP_HEALTH_JSON", ""), args[1] if len(args) > 1 else "")
    elif cmd == "backup":
        sys.exit(backup(*args))
    elif cmd == "selftest-summary":
        sys.exit(selftest_summary(args[0]))
    elif cmd == "env-get":
        print(read_env(args[0]).get(args[1], ""))
PY
}

