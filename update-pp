# Runs inside the container: token is read from the container env and fed to curl on stdin (never on argv)
SELFTEST_SH='printf "X-Webhook-Token: %s\n" "${WEBHOOK_SECRET:-}" | curl -sS -m 150 -H @- -w "\nHTTP_CODE:%{http_code}\n" "http://127.0.0.1:${WEBHOOK_LISTEN_PORT:-8080}/selftest?camera=$1" 2>&1 || true'
HEALTH_SH='curl -fsS -m 5 "http://127.0.0.1:${WEBHOOK_LISTEN_PORT:-8080}/health" 2>/dev/null || true'

# --------------------------------------------------------------------------- small helpers
dc() { $DOCKER_BIN compose "$@"; }
docker_enabled() { [ "${PP_SKIP_DOCKER:-0}" != "1" ]; }
container_running() {
    [ "$($DOCKER_BIN inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)" = "true" ]
}

wait_for_healthy() {
    STATUS="starting"
    for _ in $(seq 1 "$HEALTH_RETRIES"); do
        STATUS="$($DOCKER_BIN inspect -f '{{.State.Health.Status}}' "$CONTAINER" 2>/dev/null || echo missing)"
        [ "$STATUS" = "healthy" ] && return 0
        sleep "$HEALTH_SLEEP"
    done
    return 1
}

wait_for_running_log() {
    local logs
    for _ in $(seq 1 "$LOG_RETRIES"); do
        logs="$(dc logs --no-log-prefix "$SERVICE" 2>/dev/null || true)"
        case "$logs" in *"$RUNNING_MARKER"*) return 0 ;; esac
        sleep "$HEALTH_SLEEP"
    done
    return 1
}

# Prints the guard verdict line (ok|block|unknown<TAB>wait<TAB>message)
guard_eval() {
    if ! docker_enabled; then
        printf 'ok\t0\tdocker skipped\n'
        return 0
    fi
    if ! container_running; then
        printf 'ok\t0\twatchdog container is not running (nothing to interrupt)\n'
        return 0
    fi
    local hj logs_tmp verdict
    hj="$($DOCKER_BIN compose exec -T "$SERVICE" sh -c "$HEALTH_SH" 2>/dev/null || true)"
    logs_tmp="$(mktemp "${TMPDIR:-/tmp}/pp-logs.XXXXXX")"
    case "$hj" in
        *'"busy"'*) ;;
        *) dc logs --no-log-prefix "$SERVICE" > "$logs_tmp" 2>/dev/null || true ;;  # older watchdog: read its logs
    esac
    verdict="$(PP_HEALTH_JSON="$hj" python3 "$PYHELP" guard "$DIR/.env" "$logs_tmp" 2>/dev/null || printf 'unknown\t0\tguard helper failed\n')"
    rm -f "$logs_tmp"
    printf '%s\n' "$verdict"
}

# Initial meal-window / busy guard (before anything changes). Exits 2 when refused.
meal_guard_initial() {
    [ "$FORCE" -eq 1 ] && { warn "--force: skipping the meal-window / busy guard"; return 0; }
    local verdict state msg
    verdict="$(guard_eval)"
    state="$(printf '%s' "$verdict" | cut -f1)"
    msg="$(printf '%s' "$verdict" | cut -f3-)"
    case "$state" in
        ok)
            echo "   Meal guard: OK — ${msg}" ;;
        block)
            err "Not updating now: ${msg}."
            err "Restarting the container now would lose that meal's verification. Try again later, or use --force."
            RESULT="refused"; RESULT_DETAIL="$msg"
            exit 2 ;;
        *)
            warn "Meal guard: ${msg}."
            if [ -t 0 ] && [ -t 1 ]; then
                local ans=""
                read -r -p "   Make sure no meal is due in the next ~15 minutes. Proceed anyway? (y/N) " ans || true
                case "$ans" in y*|Y*) GUARD_CONFIRMED=1 ;; *) RESULT="refused"; RESULT_DETAIL="$msg"; exit 2 ;; esac
            else
                err "Cannot confirm it is safe to restart (non-interactive). Re-run interactively or with --force."
                RESULT="refused"; RESULT_DETAIL="$msg"
                exit 2
            fi ;;
    esac
}

# Re-check right before switching containers (the build may have taken a while): wait out a meal window.
meal_guard_before_switch() {
    [ "$FORCE" -eq 1 ] && return 0
    local waited=0 verdict state wait_s msg
    while :; do
        verdict="$(guard_eval)"
        state="$(printf '%s' "$verdict" | cut -f1)"
        wait_s="$(printf '%s' "$verdict" | cut -f2)"
        msg="$(printf '%s' "$verdict" | cut -f3-)"
        case "$state" in
            ok) return 0 ;;
            unknown) [ "${GUARD_CONFIRMED:-0}" -eq 1 ] && return 0
                     err "Meal guard: ${msg}"; return 1 ;;
        esac
        if [ $((waited + wait_s)) -gt "$GUARD_WAIT_MAX" ]; then
            err "Meal guard: ${msg}; not waiting longer than $((GUARD_WAIT_MAX / 60)) min."
            return 1
        fi
        warn "Meal guard: ${msg}. Waiting before switching containers (old version keeps running)..."
        local step="$GUARD_POLL"
        [ "$wait_s" -lt "$step" ] && step="$wait_s"
        [ "$step" -lt 1 ] && step=1
        sleep "$step"
        waited=$((waited + step))
    done
}

# Runs /selftest in the running container; prints the summary; returns the helper's exit code
run_selftest() {
    local cam="$1" raw rc=5 i
    raw="$(mktemp "${TMPDIR:-/tmp}/pp-selftest.XXXXXX")"
    for i in $(seq 1 "$SELFTEST_RETRIES"); do
        $DOCKER_BIN compose exec -T "$SERVICE" sh -c "$SELFTEST_SH" sh "$cam" > "$raw" 2>&1 || true
        rc=0
        python3 "$PYHELP" selftest-summary "$raw" || rc=$?
        [ "$rc" -ne 3 ] && break
        [ "$i" -lt "$SELFTEST_RETRIES" ] && sleep "$SELFTEST_SLEEP"
    done
    rm -f "$raw"
    return "$rc"
}

append_history() {
    local hist="$DIR/data/update-history.log" line
    line="$(date '+%Y-%m-%d %H:%M:%S %z') | ${OLD_BRANCH}@${OLD_COMMIT} -> ${NEW_BRANCH:-$OLD_BRANCH}@${NEW_COMMIT:-$OLD_COMMIT} | ${RESULT} | ${RESULT_DETAIL:-}"
    if { printf '%s\n' "$line" >> "$hist"; } 2>/dev/null; then
        return 0
    fi
    if [ -n "$SUDO" ] && sudo -n true 2>/dev/null; then
        printf '%s\n' "$line" | sudo -n tee -a "$hist" >/dev/null 2>&1 || true
    fi
}

# --------------------------------------------------------------------------- labels (operator ground truth)
restore_one_label() {
    local bkp="$1" dst="$2" rel="$3"
    if [ -n "$bkp" ] && [ -f "$bkp" ]; then
        mkdir -p "$(dirname "$dst")"
        if [ -f "$dst" ] && ! cmp -s "$bkp" "$dst"; then
            cp -p "$dst" "${dst}.upstream"
            warn "Local ${rel} differed from upstream; preserved local labels (upstream saved to ${rel}.upstream)"
        fi
        cp -p "$bkp" "$dst"
        rm -f "$bkp"
    fi
}

restore_labels() {
    restore_one_label "${LABELS_BACKUP:-}" "$LABELS_FILE" "captures/review_clips/training_labels.json"
    LABELS_BACKUP=""
    restore_one_label "${ARCHIVE_LABELS_BACKUP:-}" "$ARCHIVE_LABELS_FILE" "captures/archive/training_labels.json"
    ARCHIVE_LABELS_BACKUP=""
}

clean_tracked_labels() {
    # Only while the local copies are held in LABELS_BACKUP: lets git switch commits without a conflict
    [ -n "${LABELS_BACKUP:-}" ] && git checkout -- "captures/review_clips/training_labels.json" 2>/dev/null || true
    [ -n "${ARCHIVE_LABELS_BACKUP:-}" ] && git checkout -- "captures/archive/training_labels.json" 2>/dev/null || true
}

# --------------------------------------------------------------------------- lock / exit
acquire_lock() {
    if [ -d "$DIR/.git" ]; then LOCK_DIR="$DIR/.git/update-pp.lock"; else LOCK_DIR="${TMPDIR:-/tmp}/pp-update-$(id -u).lock"; fi
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        echo $$ > "$LOCK_DIR/pid"
        return 0
    fi
    local pid
    pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [ "$pid" = "$$" ]; then return 0; fi   # we re-executed ourselves (same PID)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        err "Another update-pp is already running (pid ${pid})."
        RESULT="refused"; RESULT_DETAIL="another update-pp running"
        LOCK_DIR=""
        exit 1
    fi
    echo $$ > "$LOCK_DIR/pid"   # stale lock from a killed run
}

on_exit() {
    local rc=$?
    restore_labels
    if [ "$HISTORY" -eq 1 ]; then
        [ "$RESULT" = "error" ] && RESULT_DETAIL="exit code ${rc}${RESULT_DETAIL:+; $RESULT_DETAIL}"
        append_history
    fi
    [ -n "${LOCK_DIR:-}" ] && rm -rf "$LOCK_DIR"
    [ -n "${PYHELP:-}" ] && rm -f "$PYHELP"
    return "$rc"
}

# --------------------------------------------------------------------------- git
restore_git() {
    [ "$OLD_COMMIT_FULL" = "unknown" ] && return 0
    [ "$(git rev-parse HEAD 2>/dev/null || true)" = "$OLD_COMMIT_FULL" ] && \
        [ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)" = "$OLD_BRANCH" ] && return 0
    clean_tracked_labels
    if [ "$OLD_BRANCH" != "HEAD" ] && [ "$OLD_BRANCH" != "unknown" ]; then
        git checkout -q -B "$OLD_BRANCH" "$OLD_COMMIT_FULL"
    else
        git checkout -q --detach "$OLD_COMMIT_FULL"
    fi
}

git_phase() {
    if [ "$OLD_BRANCH" = "HEAD" ] || [ "$OLD_BRANCH" = "unknown" ]; then
        if [ -z "$TARGET_BRANCH" ] && [ "$USE_LATEST" -eq 0 ]; then
            err "Refusing to update from detached HEAD (${OLD_COMMIT}) without an explicit target branch."
            err "Re-run with: update-pp --branch v0.6   or   update-pp --latest"
            exit 1
        fi
    fi

    # Ignore operator-writable directories (captures/, data/, exports/) when checking for dirty code files
    local dirty
    dirty="$(git status --porcelain --untracked-files=no -- . ':!captures/' ':!data/' ':!exports/' 2>/dev/null || true)"
    if [ -n "$dirty" ]; then
        err "Working tree has uncommitted changes to tracked code files:"
        printf '%s\n' "$dirty" >&2
        err "Run 'git stash' or 'git commit' on code changes first, then re-run update-pp."
        exit 1
    fi

    # Stash operator ground-truth labels aside before git operations; restored at the very end
    if [ -z "$LABELS_BACKUP" ] && [ -f "$LABELS_FILE" ]; then
        LABELS_BACKUP="$(mktemp "${TMPDIR:-/tmp}/pp-labels.XXXXXX")"
        cp -p "$LABELS_FILE" "$LABELS_BACKUP"
    fi
    if [ -z "$ARCHIVE_LABELS_BACKUP" ] && [ -f "$ARCHIVE_LABELS_FILE" ]; then
        ARCHIVE_LABELS_BACKUP="$(mktemp "${TMPDIR:-/tmp}/pp-arch-labels.XXXXXX")"
        cp -p "$ARCHIVE_LABELS_FILE" "$ARCHIVE_LABELS_BACKUP"
    fi
    git checkout -- "captures/review_clips/training_labels.json" 2>/dev/null || true
    git checkout -- "captures/archive/training_labels.json" 2>/dev/null || true

    say "Fetching all remote branches from origin..."
    git fetch origin '+refs/heads/*:refs/remotes/origin/*' --prune

    if [ -z "$TARGET_BRANCH" ]; then
        if [ "$USE_LATEST" -eq 1 ]; then
            TARGET_BRANCH="$(python3 "$PYHELP" latest-branch)"
            if [ "$TARGET_BRANCH" = "HEAD" ] || [ -z "$TARGET_BRANCH" ]; then
                err "Could not find any v* version branch to select for --latest from detached HEAD."
                exit 1
            fi
            warn "--latest specified; selected highest version branch '${TARGET_BRANCH}'"
        else
            TARGET_BRANCH="$OLD_BRANCH"
        fi
    fi

    say "Updating branch '${TARGET_BRANCH}' (--ff-only)..."
    local ok=1
    if [ "$TARGET_BRANCH" != "$OLD_BRANCH" ]; then
        if git show-ref --verify --quiet "refs/heads/${TARGET_BRANCH}"; then
            git checkout "$TARGET_BRANCH" || ok=0
        elif git show-ref --verify --quiet "refs/remotes/origin/${TARGET_BRANCH}"; then
            git checkout -b "$TARGET_BRANCH" --track "origin/${TARGET_BRANCH}" || ok=0
        else
            git checkout "$TARGET_BRANCH" || ok=0
        fi
    fi
    if [ "$ok" -eq 1 ]; then
        if git show-ref --verify --quiet "refs/remotes/origin/${TARGET_BRANCH}"; then
            git pull --ff-only origin "$TARGET_BRANCH" || ok=0
        else
            git pull --ff-only || ok=0
        fi
    fi
    if [ "$ok" -ne 1 ]; then
        err "git checkout/pull failed; restoring ${OLD_BRANCH} @ ${OLD_COMMIT}. Nothing else was changed."
        restore_git || true
        RESULT="git_failed"
        exit 1
    fi
}

# Re-run the NEWLY pulled update-pp so the rest of the update always uses the new logic
maybe_reexec() {
    [ -n "${PP_REEXEC:-}" ] && return 0
    [ -f "$DIR/update-pp" ] || return 0
    cmp -s "$DIR/update-pp" "$SCRIPT_PATH" && return 0
    say "update-pp itself changed; continuing with the new version..."
    rm -f "$PYHELP"
    export PP_REEXEC=1 PP_OLD_BRANCH="$OLD_BRANCH" PP_OLD_COMMIT_FULL="$OLD_COMMIT_FULL" \
        PP_LABELS_BACKUP="$LABELS_BACKUP" PP_ARCHIVE_LABELS_BACKUP="$ARCHIVE_LABELS_BACKUP" \
        PP_GUARD_CONFIRMED="${GUARD_CONFIRMED:-0}" POOR_PUPPY_DIR="$DIR"
    exec bash "$DIR/update-pp" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
}

# --------------------------------------------------------------------------- docker
retag_old_image() {
    # Point the old compose image name back at the pre-update image (so a later plain `docker compose up -d`,
    # e.g. pp-settings "Save & apply", can never pick up a half-tested new image)
    if [ -n "$ROLLBACK_IMAGE" ] && [ -n "$OLD_IMAGE_NAME" ]; then
        $DOCKER_BIN tag "$ROLLBACK_IMAGE" "$OLD_IMAGE_NAME" 2>/dev/null || true
    fi
}

abort_before_switch() {
    err "$1"
    restore_git || err "Could not restore git automatically: git checkout -B ${OLD_BRANCH} ${OLD_COMMIT}"
    retag_old_image
    err "Nothing was switched: the previous version (${OLD_BRANCH} @ ${OLD_COMMIT}) is still running."
    exit 1
}

tag_rollback_image() {
    ROLLBACK_IMAGE=""
    OLD_IMAGE_NAME=""
    local img name
    img="$($DOCKER_BIN inspect -f '{{.Image}}' "$CONTAINER" 2>/dev/null || true)"
    name="$($DOCKER_BIN inspect -f '{{.Config.Image}}' "$CONTAINER" 2>/dev/null || true)"
    case "$img" in
        sha256:*)
            if $DOCKER_BIN tag "$img" "${ROLLBACK_REPO}:rollback-${OLD_COMMIT}" && \
               $DOCKER_BIN tag "$img" "${ROLLBACK_REPO}:rollback"; then
                ROLLBACK_IMAGE="${ROLLBACK_REPO}:rollback-${OLD_COMMIT}"
                case "$name" in ""|sha256:*) ;; *) OLD_IMAGE_NAME="$name" ;; esac
                echo "   Rollback image: ${ROLLBACK_IMAGE} (${img:7:12})"
            fi ;;
        *) warn "No existing watchdog container found; a rollback would rebuild the previous commit instead." ;;
    esac
}

prune_rollback_tags() {
    # Keep the two newest rollback-<commit> tags (plus :rollback); untagging never deletes a running image
    $DOCKER_BIN image ls "${ROLLBACK_REPO}" --format '{{.Tag}}' 2>/dev/null | grep '^rollback-' | tail -n +3 | \
        while read -r t; do $DOCKER_BIN rmi "${ROLLBACK_REPO}:${t}" >/dev/null 2>&1 || true; done || true
}

backup_db() {
    local db="$DIR/data/kibble_history.db" out runner=""
    if { [ -e "$DIR/data/backups" ] && [ ! -w "$DIR/data/backups" ]; } || [ ! -w "$DIR/data" ]; then
        runner="$SUDO"
    fi
    out="$($runner python3 "$PYHELP" backup "$db" "$DIR/data/backups" "$OLD_COMMIT" "$BACKUP_KEEP" 2>&1)" || {
        err "Database backup failed: ${out}"
        return 1
    }
    case "$out" in
        OK\ *) BACKUP_FILE="${out#OK }"; echo "   DB backup: ${BACKUP_FILE#"$DIR"/}" ;;
        *) echo "   DB backup: ${out#SKIP }" ;;
    esac
}

rollback() {
    local why="$1"
    err "Update check failed: ${why}"
    if [ "$NO_ROLLBACK" -eq 1 ]; then
        RESULT="failed_no_rollback"; RESULT_DETAIL="$why"
        err "--no-rollback: leaving ${NEW_BRANCH} @ ${NEW_COMMIT} running. Last 30 log lines:"
        dc logs --tail 30 "$SERVICE" || true
        # Keep local labels in .local_stash when upstream changed them, so the manual git checkout below can't
        # conflict; the next update-pp run restores them automatically
        if [ -n "${LABELS_BACKUP:-}" ] && [ -f "$LABELS_BACKUP" ] && ! git diff --quiet "$OLD_COMMIT_FULL" HEAD -- "captures/review_clips/training_labels.json" 2>/dev/null; then
            cp -p "$LABELS_BACKUP" "$LABELS_STASH"; rm -f "$LABELS_BACKUP"; LABELS_BACKUP=""
            warn "Local training_labels.json stashed at ${LABELS_STASH} (auto-restored by the next update-pp run)"
        fi
        if [ -n "${ARCHIVE_LABELS_BACKUP:-}" ] && [ -f "$ARCHIVE_LABELS_BACKUP" ] && ! git diff --quiet "$OLD_COMMIT_FULL" HEAD -- "captures/archive/training_labels.json" 2>/dev/null; then
            cp -p "$ARCHIVE_LABELS_BACKUP" "$ARCHIVE_LABELS_STASH"; rm -f "$ARCHIVE_LABELS_BACKUP"; ARCHIVE_LABELS_BACKUP=""
        fi
        err "Manual rollback to ${OLD_BRANCH} @ ${OLD_COMMIT}:"
        err "  cd ${DIR} && git checkout -B ${OLD_BRANCH} ${OLD_COMMIT} && update-pp --no-pull"
        if [ -n "$ROLLBACK_IMAGE" ] && [ -n "$OLD_IMAGE_NAME" ]; then
            err "  (faster, no rebuild: after the git checkout run  docker tag ${ROLLBACK_IMAGE} ${OLD_IMAGE_NAME} && docker compose up -d --no-build --force-recreate)"
        fi
        exit 1
    fi
    dc logs --tail 30 "$SERVICE" 2>/dev/null | sed 's/^/   | /' || true
    warn "Rolling back to ${OLD_BRANCH} @ ${OLD_COMMIT}..."
    restore_git || err "git restore failed — run: git checkout -B ${OLD_BRANCH} ${OLD_COMMIT}"
    local up_ok=1
    if [ -n "$ROLLBACK_IMAGE" ] && [ -n "$OLD_IMAGE_NAME" ]; then
        retag_old_image
        dc up -d --no-build --force-recreate || up_ok=0
    else
        dc up -d --build --force-recreate || up_ok=0
    fi
    if [ "$up_ok" -eq 1 ] && wait_for_healthy; then
        echo "   Rolled-back container is ${STATUS}. Self-test of the previous version:"
        run_selftest "$CAMERA_FLAG" || true
        say "Rollback to ${OLD_COMMIT} succeeded (container status: ${STATUS})."
        RESULT="rolled_back"; RESULT_DETAIL="$why"
    else
        err "Rollback container status is '${STATUS}'. Check: docker compose -f ${DIR}/docker-compose.yml logs --tail 50"
        RESULT="rollback_failed"; RESULT_DETAIL="$why"
    fi
    echo "   Branch:     ${OLD_BRANCH} (attempted ${NEW_BRANCH} @ ${NEW_COMMIT})"
    echo "   Commit:     ${OLD_COMMIT}"
    echo "   Preserved:  .env, data/, captures/, tuya_session.json, exports/ (left untouched)"
    exit 1
}

docker_phase() {
    say "Preparing rollback point..."
    tag_rollback_image

    say "Building the new image (the current watchdog keeps running)..."
    dc build || { RESULT="build_failed"; abort_before_switch "docker compose build failed."; }

    say "Offline smoke test of the new image (no cloud; DB checked on a copy)..."
    # Explicit --name: never collides with the running container's fixed container_name
    dc run --rm --no-deps -T --name "poor-puppy-smoke-$$" --entrypoint python "$SERVICE" -c "$SMOKE_PY" || {
        RESULT="smoke_failed"; abort_before_switch "Smoke test of the new image failed."
    }

    meal_guard_before_switch || { RESULT="refused"; RESULT_DETAIL="meal window before switch"; abort_before_switch "Meal window: not switching now."; }

    say "Backing up the database..."
    backup_db || { RESULT="backup_failed"; abort_before_switch "Database backup failed."; }

    say "Switching to the new version..."
    dc up -d --no-build --force-recreate || rollback "docker compose up failed"

    say "Waiting for container healthcheck (up to ~$((HEALTH_RETRIES * HEALTH_SLEEP))s)..."
    wait_for_healthy || rollback "container status is '${STATUS}' after the update"
    wait_for_running_log || rollback "the daemon never logged '${RUNNING_MARKER}'"

    say "Connection self-test (existing session only, no feed${CAMERA_FLAG:+, camera snapshot})..."
    local rc=0
    run_selftest "$CAMERA_FLAG" || rc=$?
    case "$rc" in
        0) SELFTEST_RESULT="pass" ;;
        1) SELFTEST_RESULT="warn" ;;
        4) SELFTEST_RESULT="n/a (target version has no /selftest)" ;;
        3) rollback "self-test stayed busy (a verification kept running)" ;;
        *) rollback "connection self-test failed" ;;
    esac
    prune_rollback_tags
}

# --------------------------------------------------------------------------- --status / --selftest
do_status() {
    local branch commit cdate newest behind
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    commit="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    cdate="$(git log -1 --format='%cd' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null || echo '?')"
    say "Poor Puppy status"
    echo "   Install dir:   ${DIR}"
    echo "   Branch:        ${branch}"
    echo "   Commit:        ${commit} (${cdate})"
    if git rev-parse --git-dir >/dev/null 2>&1; then
        if git fetch -q origin '+refs/heads/*:refs/remotes/origin/*' --prune 2>/dev/null; then
            newest="$(python3 "$PYHELP" latest-branch remote 2>/dev/null || true)"
            echo "   Newest branch: ${newest:-none} (origin)"
            if [ -n "$newest" ] && [ "$newest" != "$branch" ] && \
               [ "$(printf '%s\n%s\n' "$branch" "$newest" | sort -V | tail -n 1)" = "$newest" ]; then
                echo "   Update:        ⬆️  ${newest} is available — run: update-pp --latest"
            elif git show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
                behind="$(git rev-list --count "HEAD..origin/${branch}" 2>/dev/null || echo 0)"
                if [ "${behind:-0}" -gt 0 ]; then
                    echo "   Update:        ⬆️  ${behind} new commit(s) on ${branch} — run: update-pp"
                else
                    echo "   Update:        ✅ up to date"
                fi
            fi
        else
            echo "   Update:        (could not reach origin to check)"
        fi
    fi
    if docker_enabled; then
        local health img created rb verdict
        health="$($DOCKER_BIN inspect -f '{{.State.Health.Status}}' "$CONTAINER" 2>/dev/null || echo 'not running')"
        img="$($DOCKER_BIN inspect -f '{{.Image}}' "$CONTAINER" 2>/dev/null || true)"
        created="$($DOCKER_BIN image inspect -f '{{.Created}}' "$img" 2>/dev/null | cut -c1-19 | tr T ' ' || true)"
        echo "   Container:     ${CONTAINER}: ${health}"
        echo "   Image:         ${img:7:12} (built ${created:-?})"
        rb="$($DOCKER_BIN image inspect -f '{{.Created}}' "${ROLLBACK_REPO}:rollback" 2>/dev/null | cut -c1-19 | tr T ' ' || true)"
        [ -n "$rb" ] && echo "   Rollback img:  ${ROLLBACK_REPO}:rollback (built ${rb})"
        verdict="$(guard_eval)"
        echo "   Next meal:     $(printf '%s' "$verdict" | cut -f3-) — update guard: $(printf '%s' "$verdict" | cut -f1)"
    else
        echo "   Container:     (docker skipped)"
    fi
    echo "   Update history (data/update-history.log, newest last):"
    if [ -f "$DIR/data/update-history.log" ]; then
        tail -n 5 "$DIR/data/update-history.log" | sed 's/^/     /'
    else
        echo "     (no updates recorded yet)"
    fi
}

do_selftest_cmd() {
    if ! docker_enabled; then echo "   (docker skipped)"; return 0; fi
    container_running || { err "The watchdog container is not running."; return 1; }
    say "Connection self-test (existing session only, no feed${CAMERA_FLAG:+, camera snapshot})..."
    local rc=0
    run_selftest "$CAMERA_FLAG" || rc=$?
    [ "$rc" -le 1 ] || [ "$rc" -eq 4 ]
}

# --------------------------------------------------------------------------- main
main() {
    ORIG_ARGS=("$@")
    TARGET_BRANCH=""; USE_LATEST=0; NO_PULL=0; FORCE=0; NO_ROLLBACK=0; CAMERA_FLAG=1; ACTION="update"
    while [ $# -gt 0 ]; do
        case "$1" in
            --branch)
                [ $# -ge 2 ] || { echo "Error: --branch requires a branch name" >&2; exit 1; }
                TARGET_BRANCH="$2"; shift 2 ;;
            --latest) USE_LATEST=1; shift ;;
            --no-pull) NO_PULL=1; shift ;;
            --force) FORCE=1; shift ;;
            --no-rollback) NO_ROLLBACK=1; shift ;;
            --rollback-on-fail) shift ;;
            --no-camera-check) CAMERA_FLAG=""; shift ;;
            --status) ACTION="status"; shift ;;
            --selftest) ACTION="selftest"; shift ;;
            -h|--help) usage; exit 0 ;;
            *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
        esac
    done
    if [ -n "$TARGET_BRANCH" ] && [ "$USE_LATEST" -eq 1 ]; then
        echo "✗ Error: cannot specify both --branch and --latest." >&2
        exit 1
    fi

    SCRIPT_PATH="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
    DIR="${POOR_PUPPY_DIR:-$(cd "$(dirname "$SCRIPT_PATH")" && pwd)}"
    cd "$DIR"

    SUDO=""
    [ "$(id -u)" -ne 0 ] && SUDO="sudo"
    DOCKER_BIN="${PP_DOCKER_BIN:-}"
    [ -z "$DOCKER_BIN" ] && DOCKER_BIN="${SUDO:+$SUDO }docker"
    HEALTH_RETRIES="${PP_HEALTH_RETRIES:-70}"
    HEALTH_SLEEP="${PP_HEALTH_SLEEP:-3}"
    LOG_RETRIES="${PP_LOG_RETRIES:-40}"
    SELFTEST_RETRIES="${PP_SELFTEST_RETRIES:-6}"
    SELFTEST_SLEEP="${PP_SELFTEST_SLEEP:-20}"
    GUARD_WAIT_MAX="${PP_GUARD_WAIT_MAX:-1200}"
    GUARD_POLL="${PP_GUARD_POLL:-30}"
    BACKUP_KEEP="${PP_BACKUP_KEEP:-5}"
    GUARD_CONFIRMED="${PP_GUARD_CONFIRMED:-0}"
    RESULT="error"; RESULT_DETAIL=""; HISTORY=0; LOCK_DIR=""; PYHELP=""
    ROLLBACK_IMAGE=""; OLD_IMAGE_NAME=""; BACKUP_FILE=""; SELFTEST_RESULT="skipped (docker skipped)"; STATUS=""

    LABELS_FILE="$DIR/captures/review_clips/training_labels.json"
    LABELS_STASH="$DIR/captures/review_clips/training_labels.json.local_stash"
    ARCHIVE_LABELS_FILE="$DIR/captures/archive/training_labels.json"
    ARCHIVE_LABELS_STASH="$DIR/captures/archive/training_labels.json.local_stash"
    LABELS_BACKUP="${PP_LABELS_BACKUP:-}"
    ARCHIVE_LABELS_BACKUP="${PP_ARCHIVE_LABELS_BACKUP:-}"
    trap on_exit EXIT
    write_py_helper

    # 1. Pre-flight check: must be an existing installed tree ---------------------
    if [ ! -f "$DIR/.env" ] || [ ! -d "$DIR/data" ] || [ ! -d "$DIR/captures" ]; then
        err "Refusing to run: missing .env, data/, or captures/ in ${DIR}."
        err "This looks like a fresh clone — run ./install_ubuntu.sh first."
        exit 1
    fi
    case "$ACTION" in
        status) do_status; exit 0 ;;
        selftest) do_selftest_cmd; exit $? ;;
    esac

    if [ -n "${PP_REEXEC:-}" ]; then
        OLD_BRANCH="${PP_OLD_BRANCH:-unknown}"
        OLD_COMMIT_FULL="${PP_OLD_COMMIT_FULL:-unknown}"
    else
        OLD_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
        OLD_COMMIT_FULL="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
    fi
    OLD_COMMIT="$(git rev-parse --short "$OLD_COMMIT_FULL" 2>/dev/null || echo unknown)"
    NEW_BRANCH="$OLD_BRANCH"; NEW_COMMIT="$OLD_COMMIT"
    acquire_lock
    HISTORY=1

    # If a prior failed update stashed labels pending manual rollback, pick them up now
    if [ -f "$LABELS_STASH" ] && [ -z "$LABELS_BACKUP" ]; then
        LABELS_BACKUP="$(mktemp "${TMPDIR:-/tmp}/pp-labels.XXXXXX")"
        cp -p "$LABELS_STASH" "$LABELS_BACKUP"
        rm -f "$LABELS_STASH"
    fi
    if [ -f "$ARCHIVE_LABELS_STASH" ] && [ -z "$ARCHIVE_LABELS_BACKUP" ]; then
        ARCHIVE_LABELS_BACKUP="$(mktemp "${TMPDIR:-/tmp}/pp-arch-labels.XXXXXX")"
        cp -p "$ARCHIVE_LABELS_STASH" "$ARCHIVE_LABELS_BACKUP"
        rm -f "$ARCHIVE_LABELS_STASH"
    fi

    # 2. Meal-window / busy guard, then git fetch + checkout + ff-only pull ----------
    if [ -z "${PP_REEXEC:-}" ]; then
        meal_guard_initial
        if [ "$NO_PULL" -eq 0 ]; then
            git_phase
            if [ "$(git rev-parse HEAD 2>/dev/null || true)" = "$OLD_COMMIT_FULL" ]; then
                say "Already up to date (${OLD_BRANCH} @ ${OLD_COMMIT}) — nothing to do, the watchdog was not restarted."
                echo "   (To force a rebuild + restart anyway: update-pp --no-pull)"
                RESULT="up_to_date"
                exit 0
            fi
            maybe_reexec
        else
            say "Skipping git pull (--no-pull)..."
        fi
    fi
    NEW_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    NEW_COMMIT="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

    # 3. Append any newly introduced .env.example keys without touching existing values
    python3 "$PYHELP" env-backfill "$DIR/.env" "$DIR/.env.example"
    chmod 600 "$DIR/.env" 2>/dev/null || true

    # 4. Refresh /usr/local/bin wrappers & volume ownership when running on VPS ---
    CAN_ROOT=0
    if [ "$(id -u)" -eq 0 ]; then
        CAN_ROOT=1
    elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        CAN_ROOT=1
    fi
    if docker_enabled && [ -z "${PP_DOCKER_BIN:-}" ] && [ -d /usr/local/bin ] && { [ -w /usr/local/bin ] || [ "$CAN_ROOT" -eq 1 ]; }; then
        # Ensure SQLite data/, top-level captures/review_clips dirs, and session file are owned by container uid 1000
        # without recursively walking thousands of capture media files on every update
        $SUDO chown -R 1000:1000 "$DIR/data" "$DIR/tuya_session.json" 2>/dev/null || true
        $SUDO chown 1000:1000 "$DIR/captures" "$DIR/captures/review_clips" 2>/dev/null || true
        $SUDO tee /usr/local/bin/pp-settings >/dev/null <<EOF
#!/bin/sh
POOR_PUPPY_DIR="${DIR}" exec python3 "${DIR}/scripts/pp_settings.py" "\$@"
EOF
        $SUDO chmod 755 /usr/local/bin/pp-settings
        $SUDO tee /usr/local/bin/update-pp >/dev/null <<EOF
#!/bin/sh
POOR_PUPPY_DIR="${DIR}" exec "${DIR}/update-pp" "\$@"
EOF
        $SUDO chmod 755 /usr/local/bin/update-pp
    fi

    # 5. Build, smoke test, back up, switch, verify (auto-rollback on failure) ----
    if docker_enabled; then
        docker_phase
    else
        STATUS="healthy (docker skipped)"
    fi

    # Restore stashed operator labels now that git pull and verification succeeded
    restore_labels
    if docker_enabled && [ -z "${PP_DOCKER_BIN:-}" ] && [ -f "$LABELS_FILE" ] && [ "$CAN_ROOT" -eq 1 ]; then
        $SUDO chown 1000:1000 "$LABELS_FILE" 2>/dev/null || true
    fi

    # 6. Summary ------------------------------------------------------------------
    RESULT="success"; RESULT_DETAIL="health ${STATUS}; selftest ${SELFTEST_RESULT}"
    say "Update complete!"
    echo "   Branch:     ${OLD_BRANCH} -> ${NEW_BRANCH}"
    echo "   Commit:     ${OLD_COMMIT} -> ${NEW_COMMIT}"
    echo "   Health:     ✅ ${STATUS}"
    echo "   Self-test:  ${SELFTEST_RESULT}"
    [ -n "$BACKUP_FILE" ] && echo "   DB backup:  ${BACKUP_FILE#"$DIR"/}"
    [ -n "$ROLLBACK_IMAGE" ] && echo "   Rollback:   ${ROLLBACK_IMAGE} kept (previous version image)"
    echo "   Preserved:  .env, data/, captures/, tuya_session.json, exports/ (left untouched)"
}

main "$@"
exit $?
